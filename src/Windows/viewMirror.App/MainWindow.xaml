<Window x:Class="viewMirror.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:viewMirror.App"
        Title="ViewMirror" Icon="Assets/viewMirror.ico" Width="1100" Height="760" MinWidth="640" MinHeight="400"
        Background="#080A0E" WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded" Closing="WindowClosing">
    <Window.ContextMenu>
        <ContextMenu x:Name="ReceiverMenu" Opened="MenuOpened">
            <MenuItem x:Name="ResolutionMenu" Header="解像度" />
            <MenuItem x:Name="CodecMenu" Header="コーデック" />
            <Separator />
            <MenuItem x:Name="RestartMenu" Header="受信を再起動" Click="RestartClicked" />
            <Separator />
            <MenuItem Header="終了" Click="ExitClicked" />
        </ContextMenu>
    </Window.ContextMenu>
    <Grid Background="#080A0E" MouseRightButtonUp="SurfaceRightClicked">
        <local:NativeVideoHost x:Name="VideoSurface" AutomationProperties.Name="ミラーリング映像" />
        <Grid x:Name="WaitingSurface" Background="#080A0E">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusLabel" Text="起動中…" FontSize="14" Foreground="#7F8B9D" 
                   HorizontalAlignment="Center" Margin="0,12,0,0" AutomationProperties.AutomationId="ReceiverStatus" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
